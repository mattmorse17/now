# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenClaw Agent API
VITE_OPENCLAW_API_URL=http://your-vps-ip:18789
VITE_OPENCLAW_API_KEY=your-openclaw-key

# Deepgram
VITE_DEEPGRAM_API_KEY=your-deepgram-key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase Cloud Messaging
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# Zoom OAuth (for admin session integration)
VITE_ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
VITE_ZOOM_REDIRECT_URI=https://yourdomain.com/auth/zoom/callback

# App
VITE_APP_URL=https://yourdomain.com
VITE_APP_NAME=Now
